    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Orchestrator.Domain/Orchestrator.Domain.csproj" />
    <ProjectReference Include="../../src/Orchestrator.Host/Orchestrator.Host.csproj" />
  </ItemGroup>
</Project>
